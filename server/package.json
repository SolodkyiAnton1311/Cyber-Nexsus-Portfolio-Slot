{
  "name": "demo-slot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo API for a 5x3 PixiJS slot",
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "simulate": "tsx src/simulator.ts",
    "simulate:dist": "npm run build && node dist/simulator.js",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
